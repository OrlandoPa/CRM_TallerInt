# Copia este archivo a /etc/sgrc-respaldo.env (chmod 600, dueño root) y completa.
# NUNCA lo subas al repositorio: lleva contraseñas.

# Clave PÚBLICA de age (empieza con age1...). La privada queda fuera del servidor.
AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DESTINO=/var/backups/sgrc
DIAS=14
# Latido del respaldo en healthchecks.io (un check aparte del de credenciales)
HC_URL=https://hc-ping.com/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- 1. Supabase (solo en el VPS de n8n) ---
# Pooler en modo sesión (puerto 5432), usuario <rol>.<ref del proyecto>
PGHOST=aws-1-us-east-2.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=respaldo_ro.wxtzfhqfckrjbznvqtfy
PGPASSWORD=

# --- 2. Postgres en contenedor (en el VPS de Chatwoot: su base) ---
# PG_CONTENEDOR=chatwoot-postgres-1
# PG_CONTENEDOR_USUARIO=postgres

# --- 3. n8n (nombre del contenedor; en el VPS de n8n) ---
N8N_CONTENEDOR=n8n-n8n-1

# --- 4. Configuración: carpetas con docker-compose.yml y .env ---
DIRS_CONFIG="/opt/n8n"

# --- 6. Copia en el otro VPS (opcional, recomendado) ---
# COPIA_DESTINO=respaldo@IP_DEL_OTRO_VPS:/var/backups/sgrc-remoto
# COPIA_LLAVE=/root/.ssh/sgrc_respaldo
